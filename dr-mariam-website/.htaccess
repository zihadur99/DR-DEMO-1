# Apache / cPanel: caching for the DNA scroll-sequence frames and other assets.
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  # Frames and vendored libraries never change at the same URL (bump the folder version instead)
  <If "%{REQUEST_URI} =~ m#^/assets/(seq|vendor)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/img/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/(css|js)/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
